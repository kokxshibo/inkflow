# ── Base de données PostgreSQL ────────────────────────────────────────────
# Sur Vercel : créée automatiquement par l'intégration Neon (Storage → Neon).
# En local : réutilise la même URL, ou lance un Postgres local.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Connexion directe (sans pooling) — requise par les migrations Prisma.
# Avec Neon, c'est l'URL "unpooled" (sans le suffixe -pooler dans l'hôte).
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Sécurité ──────────────────────────────────────────────────────────────
# 32 caractères minimum. Générer avec : openssl rand -base64 32
AUTH_SECRET="change-moi-32-caracteres-minimum-absolument"
APP_URL="http://localhost:3000"

# ── Stockage des fichiers ─────────────────────────────────────────────────
# Sur Vercel : fourni par Vercel Blob (Storage → Blob).
# Laisser vide en local : les fichiers vont dans public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# ── E-mail (laisser vide = les messages sont archivés sans être envoyés) ──
# Passer par un relais transactionnel, jamais directement depuis le serveur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
