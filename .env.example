# ── Base de données PostgreSQL ────────────────────────────────────────────
# Sur Vercel : créée par l'intégration Neon (Storage → Neon → Connect Project).
# En local : réutilise la même URL, ou lance un PostgreSQL local.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Sécurité ──────────────────────────────────────────────────────────────
# 32 caractères minimum. Générer avec : openssl rand -base64 32
AUTH_SECRET="change-moi-32-caracteres-minimum-absolument-ok"
# Adresse publique : sert à construire les liens envoyés aux clients (devis,
# factures, liens perso Instagram / Gmail). En production : https obligatoire.
APP_URL="http://localhost:3000"

# Relève Gmail planifiée (POST /api/integrations/sync) : jeton exigé par la route.
CRON_SECRET=""
# Serveur public : clé exigée par /bienvenue?cle=… pour créer le compte propriétaire.
SETUP_TOKEN=""

# ── Stockage des fichiers ─────────────────────────────────────────────────
# Sur Vercel : fourni par Vercel Blob (Storage → Blob → Connect Project).
# Vide en local : les fichiers vont dans public/uploads/.
BLOB_READ_WRITE_TOKEN=""
# Sur le VPS : dossier servi par nginx sous /uploads/ (Next ne sert pas les
# fichiers ajoutés à public/ après le build).
UPLOAD_DIR=""

# ── E-mail (vide = les messages sont archivés sans être envoyés) ──────────
# Passer par un relais transactionnel, jamais directement depuis le serveur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
