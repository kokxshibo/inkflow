    "lucide-react": "^0.474.0",
    "motion": "^11.18.2",
    "next": "15.1.6",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^1.7.4",
    "swissqrbill": "^4.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
